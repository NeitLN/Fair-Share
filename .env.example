# Copy this file to .env and fill in the values. Never commit .env.
#
# DB_PASSWORD is the only secret. Use letters and digits only: characters
# such as @ : / # break the connection URL. Compose builds both
# POSTGRES_PASSWORD and the web service's DATABASE_URL from it.
DB_PASSWORD=

# Optional: shown on the "/" route. Defaults to sdp-starter.
APP_NAME=sdp-starter

# Set this only when running the app directly (outside Compose). Compose
# injects DATABASE_URL itself, pointing at the db service.
DATABASE_URL=
