%% Fair-Share in production. Checked against the live services on 22/10/2026 (see docs/diagrams/README.md).
flowchart LR
    U["Browser / phone<br/><i>untrusted: holds only its own session token</i>"]

    subgraph CF["Cloudflare edge"]
        EDGE["HTTPS for both services<br/>appends X-Forwarded-For"]
    end

    subgraph Render["Render (free tier)"]
        WEB["<b>Static Site</b> fair-share-web<br/>React SPA, built by Render<br/>rewrite /* → /index.html"]
        subgraph TRUST["Trust boundary: the only place the app's secrets live"]
            API["<b>Web Service</b> fair-share-4bu9<br/>Docker image from ./Dockerfile<br/>FastAPI + Uvicorn, non-root<br/>env: DATABASE_URL, GEMINI_API_KEY"]
        end
    end

    DB[("<b>Supabase</b> PostgreSQL<br/>session pooler, TLS<br/>RLS on every table")]
    AI["<b>Google Gemini API</b><br/>generateContent<br/>gemini-3.5-flash-lite"]

    subgraph GH["GitHub Actions"]
        CI["checks on every PR:<br/>backend · frontend · images · secrets<br/><i>secrets: Render deploy hooks</i>"]
        POST["after each deploy: smoke + E2E<br/>daily: keep-alive"]
    end

    U -- "HTTPS" --> EDGE
    EDGE -- "HTML / JS / CSS" --> WEB
    EDGE -- "JSON /api/*<br/>CORS: web origin only" --> API
