%% The database schema after db/migrations/001_init.sql to 006_recurring_expenses.sql (plus
%% schema_migrations, which app/migrate.py keeps). Each table shows its keys and the columns that carry a
%% rule; the full column lists are in the migrations. Money is a whole number of đồng (bigint).
%% created_by columns point at users and have no lines, so the diagram stays readable.
erDiagram
    rate_limits {
        text bucket PK
        timestamptz window_start PK
        integer hits
    }
    schema_migrations {
        text version PK
        timestamptz applied_at
    }
    households ||--o{ members : "has"
    households ||--o{ expenses : "has"
    households ||--o{ settlements : "has"
    households ||--o{ recurring_items : "repeats"
    households ||--o{ payment_notices : "has"
    members ||--o{ expenses : "pays"
    expenses ||--|{ expense_shares : "split into"
    members ||--o{ expense_shares : "owes"
    members ||--o{ settlements : "from / to"
    members ||--o{ payment_notices : "from / to"
    recurring_items |o--o{ expenses : "recorded as"
    users ||--o{ sessions : "signs in with"
    users ||--o{ household_users : "is in"
    households ||--o{ household_users : "has people"
    members |o--o| household_users : "is the name of"
    households ||--o{ invite_codes : "invites with"

    households {
        bigint id PK
        text name "1-60"
        text access_key "secret, only to take over an old household"
    }
    members {
        bigint id PK
        bigint household_id FK
        text name "1-40, unique per household ignoring case"
    }
    expenses {
        bigint id PK
        bigint household_id FK
        bigint payer_id FK "member of the same household"
        bigint amount "dong, > 0"
        date spent_at
        text category "one of 7, default other"
        bigint recurring_item_id FK "one per item and month"
    }
    expense_shares {
        bigint expense_id PK, FK
        bigint member_id PK, FK
        bigint share_amount "dong, >= 0; sum = amount"
    }
    settlements {
        bigint id PK
        bigint household_id FK
        bigint from_member_id FK "same household"
        bigint to_member_id FK "same household, not from"
        bigint amount "dong, > 0"
    }
    recurring_items {
        bigint id PK
        bigint household_id FK
        bigint payer_id
        bigint_array member_ids "1-50, equal split"
        bigint amount "empty if it varies"
        smallint day "1-31"
        boolean active
    }
    payment_notices {
        bigint household_id PK, FK
        bigint from_member_id PK, FK
        bigint to_member_id PK, FK
        bigint amount "dong, > 0"
        text status "sent or declined"
    }
    users {
        bigint id PK
        text email "unique ignoring case"
        text password_hash "argon2id"
    }
    sessions {
        bytea token_hash PK "SHA-256 of the token"
        bigint user_id FK
        timestamptz expires_at
    }
    household_users {
        bigint household_id PK, FK
        bigint user_id PK, FK
        text role "owner, member or pending"
        bigint member_id FK "empty only while pending"
    }
    invite_codes {
        text code PK "8 characters"
        bigint household_id FK
        timestamptz expires_at
    }
