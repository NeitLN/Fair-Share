# Not needed for `npm run dev`: vite.config.ts proxies /api to localhost:8000.
# Copy to .env.local only to call another API directly (e.g. the live one).
# Public, not a secret: Vite bakes it into the JavaScript the browser downloads.
# Empty = same origin (Docker Compose: nginx proxies /api to the api service).
# Render Static Site: https://fair-share-4bu9.onrender.com
VITE_API_BASE_URL=
